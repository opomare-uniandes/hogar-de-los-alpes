{
  "type": "record",
  "name": "SolicitudTrabajoPartnerV1",
  "namespace": "com.hda.integracion.partner.v1",
  "doc": "Evento de integracion V1 emitido por un partner B2B2C. Conserva el vocabulario externo y sera traducido por la ACL.",
  "fields": [
    {"name": "specversion", "type": "string", "default": "1.0"},
    {"name": "id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "source", "type": "string"},
    {"name": "type", "type": "string", "default": "com.hda.partner.solicitud-trabajo.v1"},
    {"name": "subject", "type": "string"},
    {"name": "time", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "datacontenttype", "type": "string", "default": "application/avro"},
    {"name": "dataschema", "type": "string"},
    {"name": "correlationId", "type": {"type": "string", "logicalType": "uuid"}},
    {
      "name": "data",
      "type": {
        "type": "record",
        "name": "SolicitudTrabajoPartnerDataV1",
        "fields": [
          {"name": "partnerCode", "type": "string"},
          {"name": "requestNumber", "type": "string"},
          {"name": "insuredCustomerId", "type": "string"},
          {"name": "assistanceCode", "type": "string"},
          {"name": "priorityCode", "type": "string"},
          {"name": "cityCode", "type": "string"},
          {"name": "currencyCode", "type": "string", "default": "COP"},
          {"name": "requestedAt", "type": {"type": "long", "logicalType": "timestamp-millis"}}
        ]
      }
    }
  ]
}

