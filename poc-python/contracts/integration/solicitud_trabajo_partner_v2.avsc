{
  "type": "record",
  "name": "SolicitudTrabajoPartnerV2",
  "namespace": "com.hda.integracion.partner.v2",
  "doc": "Evento de integracion V2. Es una version mayor porque reorganiza el payload en objetos anidados.",
  "fields": [
    {"name": "specversion", "type": "string", "default": "1.0"},
    {"name": "id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "source", "type": "string"},
    {"name": "type", "type": "string", "default": "com.hda.partner.solicitud-trabajo.v2"},
    {"name": "subject", "type": "string"},
    {"name": "time", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "datacontenttype", "type": "string", "default": "application/avro"},
    {"name": "dataschema", "type": "string"},
    {"name": "correlationId", "type": {"type": "string", "logicalType": "uuid"}},
    {
      "name": "data",
      "type": {
        "type": "record",
        "name": "SolicitudTrabajoPartnerDataV2",
        "fields": [
          {
            "name": "partner",
            "type": {
              "type": "record",
              "name": "PartnerReferenceV2",
              "fields": [
                {"name": "code", "type": "string"}
              ]
            }
          },
          {
            "name": "request",
            "type": {
              "type": "record",
              "name": "RequestReferenceV2",
              "fields": [
                {"name": "number", "type": "string"},
                {"name": "requestedAt", "type": {"type": "long", "logicalType": "timestamp-millis"}}
              ]
            }
          },
          {
            "name": "insured",
            "type": {
              "type": "record",
              "name": "InsuredReferenceV2",
              "fields": [
                {"name": "customerId", "type": "string"}
              ]
            }
          },
          {
            "name": "service",
            "type": {
              "type": "record",
              "name": "RequestedServiceV2",
              "fields": [
                {"name": "code", "type": "string"},
                {"name": "priority", "type": "string"}
              ]
            }
          },
          {
            "name": "location",
            "type": {
              "type": "record",
              "name": "ServiceLocationV2",
              "fields": [
                {"name": "cityCode", "type": "string"},
                {"name": "countryCode", "type": "string", "default": "CO"}
              ]
            }
          },
          {
            "name": "payment",
            "type": {
              "type": "record",
              "name": "PaymentReferenceV2",
              "fields": [
                {"name": "currencyCode", "type": "string", "default": "COP"}
              ]
            }
          }
        ]
      }
    }
  ]
}

