# Plantilla de variables de entorno para levantar el entorno local.
#
# Uso:
#   cp .env.example .env
#   # edita .env con tus propios valores (sobre todo POSTGRES_PASSWORD)
#
# docker compose lee .env automaticamente desde este directorio.
# Los servicios Spring (trabajos-service, usuarios-service) leen estas mismas variables
# del entorno.
#
# NUNCA subas el archivo .env real al repositorio (esta en .gitignore).
# Este .env.example SI se versiona: sirve de documentacion, con valores de ejemplo.

# --- Postgres (un solo Postgres, con una base por servicio) ---
# hda_trabajos: la usa trabajos-service.
# hda_usuarios: la usa usuarios-service (base separada).
# hda_proveedor: la usa proveedor-service (Entrega 5).
# hda_trabajo_saga: la usa trabajo-saga-service, el Saga Log (Entrega 5).
POSTGRES_DB=hda_trabajos
POSTGRES_USUARIOS_DB=hda_usuarios
POSTGRES_PROVEEDOR_DB=hda_proveedor
POSTGRES_TRABAJO_SAGA_DB=hda_trabajo_saga
POSTGRES_USER=hda
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PULSAR_ADMIN_PORT=8087

# --- Redis (deduplicacion/idempotencia de integracion-service y notificaciones-service) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Pulsar (bus de eventos) ---
# service-url: protocolo binario (productores/consumidores). admin-url: REST admin + schema registry.
PULSAR_SERVICE_URL=pulsar://localhost:6650
PULSAR_ADMIN_URL=http://localhost:8080

# --- Comunicacion sincrona notificaciones-service -> usuarios-service ---
USUARIOS_SERVICE_BASE_URL=http://localhost:8084

# --- BFF: unico punto de entrada HTTP publico ---
TRABAJOS_SERVICE_BASE_URL=http://localhost:8081
TRABAJO_SAGA_SERVICE_BASE_URL=http://localhost:8086
BFF_UPSTREAM_TIMEOUT=3s
