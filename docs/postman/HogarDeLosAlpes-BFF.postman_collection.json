{
  "info": {
    "_postman_id": "48f39ef3-6b53-4e5d-bbd1-9d5d6b70f7a1",
    "name": "Hogar de los Alpes - BFF",
    "description": "Colección de entrega para validar el único punto de entrada HTTP, el camino exitoso de la saga y su compensación. Ejecute las carpetas en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Disponibilidad",
      "item": [
        {
          "name": "Salud del BFF",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health",
            "description": "Demuestra que la URL pública del BFF responde."
          },
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('BFF disponible', () => pm.response.to.have.status(200));",
              "pm.test('Estado UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ], "type": "text/javascript"}
          }]
        }
      ]
    },
    {
      "name": "01 - Saga exitosa",
      "description": "Bogotá + plomería tiene un proveedor semilla disponible. Espere unos segundos antes de consultar el seguimiento.",
      "item": [
        {
          "name": "Crear trabajo exitoso",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Correlation-Id", "value": "postman-exito-{{$guid}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"clienteId\": \"11111111-1111-1111-1111-111111111113\",\n  \"categoriaServicio\": \"plomeria\",\n  \"urgencia\": \"MEDIA\",\n  \"ciudad\": \"Bogota\",\n  \"origen\": \"MARKETPLACE\",\n  \"partnerId\": null,\n  \"moneda\": \"COP\"\n}"},
            "url": "{{baseUrl}}/api/v1/trabajos"
          },
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('Trabajo creado', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.expect(body.id).to.be.a('string');",
              "pm.environment.set('trabajoIdExitoso', body.id);",
              "pm.test('BFF entrega correlación', () => pm.expect(pm.response.headers.get('X-Correlation-Id')).to.exist);"
            ], "type": "text/javascript"}
          }]
        },
        {
          "name": "Consultar trabajo exitoso",
          "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/trabajos/{{trabajoIdExitoso}}"},
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Trabajo recuperado', () => pm.response.to.have.status(200));",
            "pm.test('Mismo identificador', () => pm.expect(pm.response.json().id).to.eql(pm.environment.get('trabajoIdExitoso')));"
          ], "type": "text/javascript"}}]
        },
        {
          "name": "Seguimiento de saga exitosa",
          "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/trabajos/{{trabajoIdExitoso}}/seguimiento"},
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Seguimiento disponible', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.expect(body.trabajo.id).to.eql(pm.environment.get('trabajoIdExitoso'));",
            "if (body.saga) { pm.environment.set('sagaIdExitoso', body.saga.sagaId); }",
            "pm.test('Saga completada o todavía en proceso', () => pm.expect(body.estadoSeguimiento).to.be.oneOf(['SAGA_PENDIENTE','INICIADA','PROVEEDOR_RESERVADO','ASIGNADA','COMPLETADA']));"
          ], "type": "text/javascript"}}]
        }
      ]
    },
    {
      "name": "02 - Saga compensada",
      "description": "Medellín + plomería no tiene proveedor semilla; dispara cancelación y notificación de fallo.",
      "item": [
        {
          "name": "Crear trabajo sin proveedor disponible",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"clienteId\": \"11111111-1111-1111-1111-111111111111\",\n  \"categoriaServicio\": \"plomeria\",\n  \"urgencia\": \"ALTA\",\n  \"ciudad\": \"Medellin\",\n  \"origen\": \"MARKETPLACE\",\n  \"partnerId\": null,\n  \"moneda\": \"COP\"\n}"},
            "url": "{{baseUrl}}/api/v1/trabajos"
          },
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Trabajo creado', () => pm.response.to.have.status(201));",
            "pm.environment.set('trabajoIdCompensado', pm.response.json().id);"
          ], "type": "text/javascript"}}]
        },
        {
          "name": "Seguimiento de compensación",
          "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/trabajos/{{trabajoIdCompensado}}/seguimiento"},
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Seguimiento disponible', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "if (body.saga) { pm.environment.set('sagaIdCompensado', body.saga.sagaId); }",
            "pm.test('Compensación visible o todavía procesándose', () => pm.expect(body.estadoSeguimiento).to.be.oneOf(['SAGA_PENDIENTE','INICIADA','COMPENSANDO','CANCELADA']));"
          ], "type": "text/javascript"}}]
        }
      ]
    },
    {
      "name": "03 - Errores controlados",
      "item": [
        {
          "name": "Trabajo inexistente",
          "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/trabajos/00000000-0000-0000-0000-000000000000"},
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Retorna 404', () => pm.response.to.have.status(404));"
          ], "type": "text/javascript"}}]
        },
        {
          "name": "Solicitud inválida",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"categoriaServicio\": \"\",\n  \"urgencia\": \"MEDIA\",\n  \"ciudad\": \"Bogota\",\n  \"origen\": \"MARKETPLACE\",\n  \"moneda\": \"COP\"\n}"},
            "url": "{{baseUrl}}/api/v1/trabajos"
          },
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Retorna 400', () => pm.response.to.have.status(400));",
            "pm.test('Error uniforme', () => pm.expect(pm.response.json()).to.have.keys('timestamp','status','error','detail','source'));"
          ], "type": "text/javascript"}}]
        }
      ]
    }
  ],
  "variable": []
}
